# =============================================================================
# DELTA - deployment configuration
#
# Copy this file to .env and edit it:
#
#   PowerShell   Copy-Item .env.example .env
#   Linux/macOS  cp .env.example .env
#
# Docker Compose reads .env twice: to fill in ${...} in docker-compose.yml, and
# to pass settings to the DELTA container. Every value here is plain text.
#
# .env holds every secret in this deployment. Do not commit it. The supplied
# .gitignore already excludes it.
#
# Every setting is explained in docs/configuration.md.
#
# Avoid the "$" character in any value. Compose treats it as the start of a
# variable reference. Regenerate the secret instead of trying to escape it.
# =============================================================================

# --- Image -------------------------------------------------------------------
# prod-latest is a MOVING tag. Starting a new image runs a schema migration
# that cannot be undone, so for anything you care about, pin a digest:
#
#   DELTA_IMAGE=ghcr.io/preventionweb/delta-country@sha256:<digest>
#
# docs/update.md explains how to find the digest and how to update safely.
DELTA_IMAGE=ghcr.io/preventionweb/delta-country:prod-latest

# --- Public address ----------------------------------------------------------
# The address people use to reach this deployment. Include the port only if it
# is not the standard one for the scheme (http 80, https 443).
#
#   http://localhost              local testing
#   https://delta.example.org     production
#   https://delta.example.org:8443
#
# DELTA marks session cookies Secure. On a real hostname this must be https://
# or users will not stay signed in. See docs/configuration.md.
PUBLIC_URL=http://localhost

# --- Published ports ---------------------------------------------------------
# The host ports the bundled nginx listens on. Not used if you removed nginx.
HTTP_PORT=80
#HTTPS_PORT=443

# --- Database ----------------------------------------------------------------
# Used by the bundled db service, and by docker-compose.yml to build the
# connection string DELTA uses. For the bundled database, leave DATABASE_URL
# below commented out - Compose builds it from these three values, and a
# DATABASE_URL set here would be ignored anyway because the compose file
# overrides it.
#
# POSTGRES_PASSWORD takes effect ONLY when the data volume is first created.
# Changing it later changes what DELTA sends, not what the database expects -
# the fix is ALTER ROLE plus this file, never deleting the volume.
#
# Generate a password made only of letters and digits. Other characters are
# allowed but must be percent-encoded in a connection URL; letters and digits
# avoid that entirely. docs/configuration.md gives the commands and the
# encoding rules.
POSTGRES_USER=delta
POSTGRES_DB=delta
POSTGRES_PASSWORD=CHANGE_ME

# EXTERNAL DATABASE ONLY (patterns B and D). Uncomment and set the full
# connection string, AND change the DATABASE_URL line in docker-compose.yml to
#     DATABASE_URL: ${DATABASE_URL}
# Both edits are needed - docs/deployment-options.md walks through them.
# Percent-encode any character in the username or password that is not a
# letter, digit, "-", ".", "_" or "~" - see docs/configuration.md.
#DATABASE_URL=postgresql://delta:password@db.example.org:5432/delta?sslmode=require

# --- Session -----------------------------------------------------------------
# Must be unique to this deployment and generated with a cryptographically
# secure generator. Changing it later signs every user out.
#
#   Linux/macOS  openssl rand -base64 32
#   PowerShell   $b=[byte[]]::new(32)
#                [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#                [Convert]::ToBase64String($b)
#
# If the result contains a "$", generate another one.
SESSION_SECRET=CHANGE_ME

# --- Required application settings -------------------------------------------
# DELTA checks these on every page load and shows a "System configuration
# errors" page if any is missing. Present is not the same as defaulted - leave
# them set even at their default values.

# How people sign in. Comma-separated. Only "form" and "sso_azure_b2c" are
# recognised. "form" is normal sign-in with an email address and password.
AUTHENTICATION_SUPPORTED=form

# "file" or "smtp", and nothing else. "file" writes mail to the container log
# instead of sending it, which is why a new deployment needs no mail server.
EMAIL_TRANSPORT=file

# The sender address. It must contain both "@" and "." - "delta@localhost" is
# rejected. .invalid can never resolve, which is what you want while mail is
# not actually being sent.
EMAIL_FROM=noreply@delta.invalid

# --- SMTP - required only when EMAIL_TRANSPORT=smtp --------------------------
# With EMAIL_TRANSPORT=smtp, all four of HOST, PORT, USER and PASS become
# mandatory. Missing any one produces the configuration-errors page.
#SMTP_HOST=smtp.example.org
#SMTP_PORT=587
#SMTP_USER=delta
#SMTP_PASS=
# Implicit TLS on connect: true for port 465, false for 587 and 25.
#SMTP_SECURE=false

# --- Azure AD B2C - required only when AUTHENTICATION_SUPPORTED includes it ---
#SSO_AZURE_B2C_TENANT=
#SSO_AZURE_B2C_CLIENT_ID=
#SSO_AZURE_B2C_CLIENT_SECRET=

# --- Optional ----------------------------------------------------------------
# Application log verbosity and how long DELTA keeps its own log files.
#LOG_LEVEL=info
#LOG_RETENTION_DAYS=30

# Alternative image sources, for example an internal registry mirror.
#DB_IMAGE=postgis/postgis:17-3.5
#NGINX_IMAGE=nginx:1.29-alpine

# The Compose project name decides the real names of the containers, network
# and data volumes (<project>_pgdata and so on). docker-compose.yml pins it to
# "delta" so this directory can be renamed or moved safely.
#
# Running a SECOND DELTA deployment on the same host? That one MUST set a
# distinct name here, or the two share containers and volumes. Changing it on
# an EXISTING deployment points it at a different, empty set of volumes - the
# old data is still there under the old name, but nothing is using it.
# Read docs/configuration.md before changing this.
#COMPOSE_PROJECT_NAME=delta
